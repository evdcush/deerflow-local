DEER_FLOW_PORT=2026
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# The search gateway's GATEWAY_API_KEY (empty if it runs without one).
SEARCH_GATEWAY_API_KEY=replace-with-the-search-gateway-key

# LiteLLM key; any non-empty value if LiteLLM runs without auth.
LITELLM_API_KEY=ayyylmao

# Service key for programs that call DeerFlow's API (openssl rand -hex 32).
# Each client gets the same value. It is passed to DeerFlow as
# DEER_FLOW_INTERNAL_AUTH_TOKEN; clients send it in X-DeerFlow-Internal-Token
# (see README, ".env"). Empty: no API access.
DEERFLOW_API_KEY=
